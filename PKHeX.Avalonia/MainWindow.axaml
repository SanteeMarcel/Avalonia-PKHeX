<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PKHeX.Avalonia"
        x:Class="PKHeX.Avalonia.MainWindow"
        Width="1180" Height="720"
        Title="PKHeX — Avalonia preview (two-save transfer + edit)">
  <Grid Margin="8" ColumnDefinitions="*,Auto,*">

    <local:SavePanel x:Name="LeftPanel" Grid.Column="0" Margin="0,0,6,0"/>

    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" Margin="6,0">
      <TextBlock Text="Transfer" FontWeight="Bold" HorizontalAlignment="Center"/>
      <Button x:Name="MoveRightButton" Content="Send  ▶" HorizontalAlignment="Stretch"/>
      <Button x:Name="MoveLeftButton"  Content="◀  Send" HorizontalAlignment="Stretch"/>
      <CheckBox x:Name="RemoveSourceCheck" Content="Remove from source"/>
      <Border Height="1" Background="#33808080"/>
      <TextBlock x:Name="MoveStatus" Width="150" TextWrapping="Wrap" FontSize="11" Opacity="0.85"
                 Text="Load a save on each side, select a Pokémon, then Send. Double-click a slot to edit it."/>
    </StackPanel>

    <local:SavePanel x:Name="RightPanel" Grid.Column="2" Margin="6,0,0,0"/>

  </Grid>
</Window>
