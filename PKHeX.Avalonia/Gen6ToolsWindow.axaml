<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PKHeX.Avalonia.Gen6ToolsWindow"
        Width="980" Height="680"
        Title="Gen 6 Tools">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="ApplyButton" Content="Apply &amp; Close"/>
      <Button x:Name="CloseButton" Content="Close"/>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Opacity="0.85"/>
    </StackPanel>
    <TabControl x:Name="RootTabs"/>
  </DockPanel>
</Window>
